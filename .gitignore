# --- Runtime state & user config (never commit real data) ---
state.db
state.db-*
services_config.json
projects_config.json
settings.json
.env
*.corrupt-*

# --- Logs ---
logs/
*.log
dashboard*.log

# --- Root-level scratch dumps only ---
/*.txt
!requirements.txt
!version.txt
nul

# --- Local dev/audit tooling ---
audit/
_t/*
!_t/i18n_check.py
_legacy_qml/
shots/
AGENT_PROMPT.md
.agents/
.claude/
.omx/
.playwright-cli/
skills-lock.json

# --- Build artifacts ---
build/
dist/
*.exe
*.spec.bak

# --- Python ---
__pycache__/
*.pyc
*.tmp

# --- Frontend ---
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# --- Research: keep reports, drop fetch junk ---
research/**/_verify/
research/**/verify/
research/**/.raw/
research/**/.work/
research/**/nul

# research screenshots may contain private topology
research/**/*.png
research/**/raw/

# bound api port marker (lives in DATA_DIR)
api.port

# --- WebView2 runtime data (dev-mode window profile) ---
webview/

# --- One-off config backups ---
*.backup-*
build-stage/
